{
 "query_workload": {
  "language": "promql",
  "repeating_queries": [
   {
    "query": "topk(10, sum by (url) (rate(http_requests_total[5m])))",
    "demand": {
     "fixed_interval_at": {
      "interval": 10000,
      "evaluation_phase": 0
     }
    },
    "predictability": {
     "predictable": {
      "known_at": null
     }
    },
    "requirements": {
     "accuracy": {
      "accuracy_metric": "absolute_stream_l2",
      "max_error": 0.05,
      "failure_probability": 0.1,
      "accuracy_scope": "whole_result"
     }
    }
   }
  ]
 },
 "data_workload": {
  "arrival": {
   "ingesting": {
    "rows_per_second": 1000.0
   }
  },
  "sources": {
   "http_requests_total": {
    "series_count": 100,
    "metric_type": "counter",
    "sample_interval": 100,
    "distinct_values_per_label": {
     "url": 100,
     "instance": 1
    }
   }
  }
 }
}
